# Salin menjadi .env lalu isi nilainya. JANGAN commit file .env.

# --- Keamanan ---
# Pengembangan lokal: True. Server: False.
DEBUG=True
# Kunci rahasia acak (minimal 50 karakter). Buat dengan:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=

# --- Alamat server (wajib diisi di server, boleh kosong di lokal) ---
# Alamat/domain yang boleh mengakses backend, pisahkan dengan koma.
ALLOWED_HOSTS=
# Alamat web admin yang boleh memanggil API (contoh: http://103.151.63.84).
CORS_ALLOWED_ORIGINS=
# Alamat asal untuk login Django Admin Panel (biasanya sama dengan di atas).
CSRF_TRUSTED_ORIGINS=

# --- Database PostgreSQL ---
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# --- Gemini API ---
GEMINI_API_KEY=
# Opsional: urutan model AI (pisahkan koma). Kosong = urutan bawaan.
# GEMINI_MODELS=
# Batas waktu AI (detik). Kosong = 75 per model, 180 total.
# Server di belakang Cloudflare (putus setelah 100 detik):
# GEMINI_TIMEOUT_SECONDS=60
# AI_TOTAL_BUDGET_SECONDS=70
